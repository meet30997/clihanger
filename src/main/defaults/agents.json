{
  "terminal": {
    "label": "Terminal",
    "command": "",
    "color": "#adadad",
    "kind": "shell"
  },
  "claude": {
    "label": "Claude Code",
    "command": "claude",
    "color": "#d97757",
    "resumePickerCommand": "{command} --resume",
    "resumeCommand": "{command} --resume {conversationId}",
    "resumeFailurePattern": "No\\s+conversation\\s+found\\s+with\\s+session\\s+ID",
    "chatPromptPattern": "^[^\\S\\r\\n]*[❯›>](?:[^\\S\\r\\n]+(.*)|[^\\S\\r\\n]*)$",
    "chatTitlePattern": "^\\s*(?:[└⎿]\\s*)?(?:Session|Conversation|Thread) renamed to:\\s*(.+)$|^─{3,} +(.+?) +─ *$",
    "conversationHistory": {
      "format": "transcript-jsonl",
      "path": "~/.claude/projects/{projectKey}"
    },
    "icon": {
      "file": "agent-icons/provider-1.png",
      "monochrome": true
    },
    "launchOptions": [
      {
        "id": "skip-permissions",
        "label": "Skip permission checks",
        "args": [
          "--dangerously-skip-permissions"
        ],
        "description": "Bypasses all tool permission checks. Use only in an isolated, trusted environment.",
        "enabled": false,
        "group": "permissions",
        "dangerous": true
      },
      {
        "id": "plan",
        "label": "Plan mode",
        "args": [
          "--permission-mode",
          "plan"
        ],
        "description": "Start in planning mode to review an approach before making changes.",
        "enabled": false,
        "group": "permissions"
      },
      {
        "id": "accept-edits",
        "label": "Accept file edits",
        "args": [
          "--permission-mode",
          "acceptEdits"
        ],
        "description": "Allow file edits without asking for each edit.",
        "enabled": false,
        "group": "permissions"
      },
      {
        "id": "verbose",
        "label": "Verbose output",
        "args": [
          "--verbose"
        ],
        "description": "Show additional details in CLI output.",
        "enabled": false
      },
      {
        "id": "no-chrome",
        "label": "Disable Chrome integration",
        "args": [
          "--no-chrome"
        ],
        "description": "Keep browser integration disabled for this session.",
        "enabled": false
      }
    ]
  },
  "codex": {
    "label": "Codex CLI",
    "command": "codex",
    "color": "#10a37f",
    "resumePickerCommand": "{command} resume",
    "resumeCommand": "{command} resume {conversationId}",
    "resumeFailurePattern": "No\\s+saved\\s+session\\s+found\\s+with\\s+ID",
    "chatPromptPattern": "^[^\\S\\r\\n]*[❯›>](?:[^\\S\\r\\n]+(.*)|[^\\S\\r\\n]*)$",
    "chatTitlePattern": "^\\s*(?:[└⎿]\\s*)?(?:Session|Conversation|Thread) renamed to:\\s*(.+)$|^[^\\n]* · (?:/|~)[^\\n]* · ([^\\n]+)$",
    "conversationHistory": {
      "format": "sqlite",
      "path": "~/.codex/state_5.sqlite",
      "query": "SELECT id AS conversationId, COALESCE(NULLIF(name, ''), title) AS title, cwd AS projectPath, substr(first_user_message, 1, 400) AS firstMessage, created_at * 1000 AS createdAt, updated_at * 1000 AS updatedAt FROM threads WHERE cwd = $projectPath AND (source = 'cli' OR originator = 'codex-tui') ORDER BY updated_at DESC LIMIT 100",
      "activity": {
        "path": "~/.codex/history.jsonl",
        "idField": "session_id",
        "textField": "text",
        "timestampField": "ts",
        "timestampUnit": "seconds"
      }
    },
    "icon": {
      "file": "agent-icons/provider-2.png",
      "monochrome": false
    },
    "launchOptions": [
      {
        "id": "skip-permissions",
        "label": "Skip approvals and sandbox",
        "args": [
          "--dangerously-bypass-approvals-and-sandbox"
        ],
        "description": "Disables approval prompts and sandboxing. Commands run with your user permissions.",
        "enabled": false,
        "group": "permissions",
        "dangerous": true
      },
      {
        "id": "read-only",
        "label": "Read-only sandbox",
        "args": [
          "--sandbox",
          "read-only"
        ],
        "description": "Restrict model-generated shell commands to read-only access.",
        "enabled": false,
        "group": "permissions"
      },
      {
        "id": "workspace-write",
        "label": "Workspace write sandbox",
        "args": [
          "--sandbox",
          "workspace-write"
        ],
        "description": "Allow writes in the workspace within the sandbox.",
        "enabled": false,
        "group": "permissions"
      },
      {
        "id": "search",
        "label": "Live web search",
        "args": [
          "--search"
        ],
        "description": "Enable live web search instead of the default cached search.",
        "enabled": false
      },
      {
        "id": "inline",
        "label": "Inline terminal display",
        "args": [
          "--no-alt-screen"
        ],
        "description": "Preserve terminal scrollback by disabling the alternate screen.",
        "enabled": false
      }
    ]
  },
  "agy": {
    "label": "Antigravity",
    "command": "agy",
    "color": "#4285f4",
    "resumePickerCommand": "{command} --continue",
    "resumeCommand": "{command} --conversation {conversationId}",
    "resumeFailurePattern": "conversation\\s+.*\\s+not\\s+found",
    "chatPromptPattern": "^[^\\S\\r\\n]*[❯›>](?:[^\\S\\r\\n]+(.*)|[^\\S\\r\\n]*)$",
    "chatTitlePattern": "^\\s*(?:[└⎿]\\s*)?(?:Session|Conversation|Thread) renamed to:\\s*(.+)$",
    "conversationHistory": {
      "format": "sqlite",
      "path": "~/.gemini/antigravity-cli/conversation_summaries.db",
      "query": "SELECT conversation_id AS conversationId, title, workspace_uris AS projectPaths, last_modified_time AS updatedAt FROM conversation_summaries WHERE workspace_uris LIKE '%' || $projectPath || '%' ORDER BY last_modified_time DESC LIMIT 100",
      "activity": {
        "path": "~/.gemini/antigravity-cli/history.jsonl",
        "idField": "conversationId",
        "textField": "display",
        "timestampField": "timestamp"
      }
    },
    "icon": {
      "file": "agent-icons/provider-3.png",
      "monochrome": false
    },
    "launchOptions": [
      {
        "id": "skip-permissions",
        "label": "Skip permission checks",
        "args": [
          "--dangerously-skip-permissions"
        ],
        "description": "Auto-approve all tool permission requests. Use only in an isolated, trusted environment.",
        "enabled": false,
        "group": "permissions",
        "dangerous": true
      },
      {
        "id": "plan",
        "label": "Plan mode",
        "args": [
          "--mode",
          "plan"
        ],
        "description": "Start in planning mode.",
        "enabled": false,
        "group": "permissions"
      },
      {
        "id": "accept-edits",
        "label": "Accept file edits",
        "args": [
          "--mode",
          "accept-edits"
        ],
        "description": "Use the CLI’s accept-edits mode.",
        "enabled": false,
        "group": "permissions"
      },
      {
        "id": "sandbox",
        "label": "Terminal sandbox",
        "args": [
          "--sandbox"
        ],
        "description": "Enable terminal restrictions.",
        "enabled": false,
        "group": "permissions"
      },
      {
        "id": "high-effort",
        "label": "High reasoning effort",
        "args": [
          "--effort",
          "high"
        ],
        "description": "Request high reasoning effort for this session.",
        "enabled": false
      }
    ]
  }
}
