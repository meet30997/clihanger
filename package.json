{
  "name": "clihanger",
  "version": "0.3.0",
  "private": true,
  "description": "A macOS workspace for running Claude Code, Codex and other agent CLIs side by side, with attention routing and a ports panel.",
  "main": "src/main/main.js",
  "author": "meet30997",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meet30997/clihanger.git"
  },
  "homepage": "https://github.com/meet30997/clihanger#readme",
  "bugs": "https://github.com/meet30997/clihanger/issues",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "tmux",
    "electron",
    "macos",
    "terminal",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "electron-builder --mac --dir && codesign --force --deep --sign - $(find dist -maxdepth 2 -name CliHanger.app -type d | head -n 1)",
    "install-app": "bash scripts/build-and-open.sh",
    "build:open": "bash scripts/build-and-open.sh"
  },
  "build": {
    "appId": "dev.clihanger.app",
    "productName": "CliHanger",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "identity": null,
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert"
      }
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
